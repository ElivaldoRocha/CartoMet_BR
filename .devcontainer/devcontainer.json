{
  "name": "CartoMet BR — Desktop Remoto",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Desktop-lite instala o servidor noVNC (acesso via navegador na porta 6080)
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "carto",
      "noVncPort": 6080
    }
  },

  // Dependências de sistema: Qt (xcb/EGL) + Cartopy (GEOS/PROJ)
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends libgeos-dev libproj-dev proj-data libgl1-mesa-glx libegl1 libxcb-cursor0 libxcb-xinerama0 libdbus-1-3",

  // Instala o uv e sincroniza o ambiente com uv.lock
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc && $HOME/.local/bin/uv sync",

  // Variáveis necessárias para Qt rodar no display virtual do noVNC
  "remoteEnv": {
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "MPLBACKEND": "QtAgg",
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },

  // Expõe a porta do noVNC e abre automaticamente no navegador
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop Remoto (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },

  // Para o Codespace ao fechar a aba (evita cobrar horas desnecessárias)
  "shutdownAction": "stopCodespace",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
