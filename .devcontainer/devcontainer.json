{
  "name": "CartoMet BR — Desktop Remoto",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "carto",
      "noVncPort": 6080
    }
  },

  // Libs que o Qt6 xcb platform plugin exige e que o desktop-lite não instala:
  //   libegl1              — EGL (Qt6 obrigatório no Linux)
  //   libxcb-cursor0       — Qt >= 6.5 exige explicitamente
  //   libxcb-icccm4        — ICCCM (inter-client communication)
  //   libxcb-image0        — imagens via xcb
  //   libxcb-keysyms1      — mapeamento de teclas
  //   libxcb-render-util0  — utilitários de render xcb
  //   libxcb-xinerama0     — suporte a múltiplos monitores
  //   libxkbcommon-x11-0   — suporte a teclado X11
  //   libeccodes0          — biblioteca C que cfgrib exige para ler GRIB2
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends libegl1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxkbcommon-x11-0 fonts-noto-color-emoji libeccodes0",

  "postCreateCommand": "pip install uv && uv sync",

  "remoteEnv": {
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "MPLBACKEND": "QtAgg"
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop Remoto (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },

  "shutdownAction": "stopCodespace",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
