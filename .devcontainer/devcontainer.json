{
  "name": "CartoMet BR — Desktop Remoto",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "carto",
      "noVncPort": 6080
    }
  },

  // desktop-lite já instala libgl1, libegl1, libdbus-1-3 e as libs xcb/EGL.
  // Só precisamos adicionar:
  //   libxcb-cursor0         — Qt6 exige explicitamente esta lib no Linux
  //   fonts-noto-color-emoji — emojis coloridos no painel de simbologias
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends libxcb-cursor0 fonts-noto-color-emoji",

  // pip install uv é mais confiável que o curl|sh no contexto do devcontainer
  // (sem problemas de PATH ou de shell não-interativo).
  "postCreateCommand": "pip install uv && uv sync",

  "remoteEnv": {
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "MPLBACKEND": "QtAgg"
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop Remoto (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },

  "shutdownAction": "stopCodespace",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
